{
  "name": "convit",
  "version": "0.1.0",
  "description": "Conventional commits by AI. Weighted analysis, surgical diffs, and local data sovereignty.",
  "author": "Kareem Ahmed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kareem-AEz/the-road-to-next.git",
    "directory": "packages/convit"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "conventional-commits",
    "cli",
    "openai",
    "privacy",
    "security",
    "local-llm",
    "lm-studio",
    "ollama",
    "data-sovereignty"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "convit": "./dist/convit.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "commit": "tsx bin/convit.ts",
    "type:check": "tsc --noEmit",
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.33",
    "@clack/prompts": "^1.1.0",
    "ai": "^6.0.111",
    "cosmiconfig": "^9.0.1",
    "dotenv": "^17.3.1",
    "js-tiktoken": "^1.0.21",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
