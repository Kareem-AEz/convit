# convit — copy to .env and fill in
# API key is never read from .convitrc (config files get committed)

CONVIT_URL=https://api.openai.com/v1
CONVIT_KEY=sk-...
CONVIT_MODEL=gpt-4o

# Optional: request timeout in milliseconds (default: 60000)
# CONVIT_TIMEOUT=60000

# Optional: cost tracking ($ per 1M tokens)
# CONVIT_INPUT_COST=0.5
# CONVIT_OUTPUT_COST=3
